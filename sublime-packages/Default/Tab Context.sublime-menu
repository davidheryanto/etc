// Override of the packaged Packages/Default/Tab Context.sublime-menu.
// Verbatim copy as of build 4200, plus the "Close Other Tabs" line below
// "Close Tab" and the Copy Path / Copy Relative Path / Copy Filename
// section — a loose file here shadows the whole packaged menu, so this
// is the only way to control entry position (menu files from other packages
// can only append, since User loads last).
//
// Pairs with User/close_other_tabs.py, which supplies the close_other_tabs
// command. Build 4200 ships close_others_by_index but hides it at render
// time, which is why that line is commented out below rather than used.
//
// This file freezes the menu at build 4200. After a Sublime update, re-sync
// against the shipped copy:
//   unzip -p "<install>/Packages/Default.sublime-package" "Tab Context.sublime-menu"
//   # <install> = /opt/sublime_text on Linux
//   #             /Applications/Sublime Text.app/Contents/MacOS on macOS
[
	{ "command": "close_by_index", "args": { "group": -1, "index": -1 }, "caption": "Close Tab" },
	{ "command": "close_other_tabs", "args": { "group": -1, "index": -1 }, "caption": "Close Other Tabs" },
	// { "command": "close_others_by_index", "args": { "group": -1, "index": -1 }, "caption": "Close Other Tabs" },
	{ "caption": "-" },
	{ "command": "close_selected", "args": {"group":-1, "index": -1}, "caption": "Close Selected Tabs" },
	{ "command": "close_unselected", "args": {"group":-1, "index": -1}, "caption": "Close Unselected Tabs" },
	{ "command": "close_to_right_by_index", "args": { "group": -1, "index": -1 }, "caption": "Close Tabs to the Right" },
	{ "command": "close_unmodified", "args": { "group": -1, "index": -1 }, "caption": "Close Unmodified Tabs" },
	{ "command": "close_unmodified_to_right_by_index", "args": { "group": -1, "index": -1 }, "caption": "Close Unmodified Tabs to the Right" },
	{ "command": "close_deleted_files", "args": { "group": -1 }, "caption": "Close Tabs With Deleted Files" },
	{ "caption": "-" },
	// Same commands and captions as the side bar (see User/side_bar_extras.py).
	// They hide themselves on tabs with no file, e.g. an unsaved buffer.
	{ "command": "copy_absolute_path", "args": { "group": -1, "index": -1 }, "caption": "Copy Path" },
	{ "command": "copy_relative_path", "args": { "group": -1, "index": -1 }, "caption": "Copy Relative Path" },
	{ "command": "copy_filename", "args": { "group": -1, "index": -1 }, "caption": "Copy Filename" },
	{ "caption": "-" },
	{ "command": "clone_file", "args": { "add_to_selection": true, "group": -1, "index": -1, "retain_viewport_position": true }, "caption": "Split View" },
	{ "caption": "-" },
	{ "command": "new_file", "caption": "New File" },
	{ "command": "prompt_open_file", "caption": "Open File" },
]
