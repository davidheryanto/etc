{
	"manifest_version": 3,
	"name": "Markdown Viewer",
	"version": "2.1.2",
	"description": "Renders local .md files as clean HTML. Runs only on file:// markdown URLs; no network, no storage, no background worker.",
	"homepage_url": "https://github.com/davidheryanto/etc/tree/main/chrome-extensions/markdown-viewer",
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"content_scripts": [
		{
			"matches": ["file:///*"],
			"include_globs": [
				"*.md",
				"*.md#*",
				"*.markdown",
				"*.markdown#*",
				"*.MD",
				"*.MD#*"
			],
			"js": ["markdown-it.min.js", "highlight.min.js", "content.js"],
			"css": ["theme.css"],
			"run_at": "document_end"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["fonts/*.woff2"],
			"matches": ["file:///*"]
		}
	]
}
