#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["rich>=13"]
# ///
"""Live per-process network rates on macOS — who is eating your bandwidth.

Wraps `nettop -d` (delta mode) and renders a sorted, auto-refreshing table.
No sudo needed: nettop reports system-wide traffic to unprivileged users.

Keys while running:  d down   u up   t total   r reverse   q quit
"""

from __future__ import annotations

import argparse
import contextlib
import math
import os
import re
import select
import subprocess
import sys
import termios
import threading
import time
import tty

from rich.console import Console, Group
from rich.live import Live
from rich.text import Text

IFACE_CHOICES = {"all": None, "external": "external", "wifi": "wifi", "wired": "wired"}
IFACE_LABEL = {"all": "all interfaces", "external": "external interfaces",
               "wifi": "Wi-Fi", "wired": "wired interfaces"}
IFACE_SHORT = {"all": "all", "external": "external", "wifi": "Wi-Fi", "wired": "wired"}
SORT_KEYS = {"d": "down", "u": "up", "t": "total"}
SORT_IDX = {"down": 2, "up": 3}
PEAK_DECAY = 0.8  # how fast the bar scale is allowed to shrink

# Layout, in terminal cells. Widths are computed per frame from the window size,
# but every frame at a given size is identical, so nothing jitters between samples.
GUTTER = 2                       # left margin
MAX_WIDTH = 120                  # content stops growing past this
W_PID, W_RATE = 5, 9             # "99999", "99.9 MB/s"
NAME_MIN, NAME_MAX = 16, 30
BAR_MIN, BAR_MAX = 7, 40       # 7 fits the "Total ▾" title
CHROME = 6                       # margin, totals, gap, column titles, gap, keys
DOWN, UP = "cyan", "magenta"     # ANSI names, so the user's terminal theme decides
UNITS = ("B/s", "KB/s", "MB/s", "GB/s", "TB/s")
KEYS = (("d", "down"), ("u", "up"), ("t", "total"), ("r", "reverse"), ("q", "quit"))

_NAME_CACHE: dict[str, str] = {}


def human(bps: float) -> str:
    """Bytes/sec -> at most 9 cells ("99.9 MB/s"). Decimal units: 1 KB = 1000 B."""
    if round(bps) < 1000:
        return f"{max(1, round(bps)) if bps > 0 else 0} B/s"
    v = bps
    for unit in UNITS[1:]:
        v /= 1000
        num = f"{v:.1f}" if v < 99.95 else f"{v:.0f}"
        if float(num) < 1000 or unit == UNITS[-1]:
            return f"{num} {unit}"
    raise AssertionError("unreachable")


def real_names(pids: list[str]) -> dict[str, str]:
    """PID -> friendly app name. nettop truncates/mangles names; ps has the full path,
    from which we prefer the enclosing .app bundle name."""
    want = [p for p in pids if p and p not in _NAME_CACHE]
    if want:
        args = sum((["-p", p] for p in want), [])
        try:
            out = subprocess.run(["ps", "-o", "pid=,comm=", *args],
                                 capture_output=True, text=True).stdout
        except OSError:
            out = ""
        for line in out.splitlines():
            pid, _, path = line.strip().partition(" ")
            m = re.search(r"([^/]+)\.app/", path)
            _NAME_CACHE[pid] = m.group(1) if m else path.rsplit("/", 1)[-1]
        for p in want:
            _NAME_CACHE.setdefault(p, "")
    return _NAME_CACHE


def sort_rows(rows, key: str, desc: bool):
    """Order rows by download, upload, or the sum of both."""
    if key == "total":
        rank = lambda r: r[2] + r[3]  # noqa: E731
    else:
        i = SORT_IDX[key]
        rank = lambda r: (r[i], r[2] + r[3])  # noqa: E731  tie-break on total
    return sorted(rows, key=rank, reverse=desc)


def sample(interval: int, iface: str | None, poll) -> list:
    """One delta sample. poll(keys) runs every 0.1s while nettop works, with any
    keypresses (or "" if none), so sort changes and resizes redraw instantly.
    poll may raise to quit; nettop is never left running behind us."""
    cmd = ["nettop", "-P", "-d", "-L", "2", "-x",
           "-J", "bytes_in,bytes_out", "-s", str(interval)]
    if iface:
        cmd += ["-t", iface]
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
    except FileNotFoundError:
        sys.exit("nettop not found — this script is macOS-only.")

    captured: list[str] = []
    try:
        reader = threading.Thread(target=lambda: captured.append(proc.stdout.read()),
                                  daemon=True)
        reader.start()
        tty_in = sys.stdin.isatty()
        while proc.poll() is None:  # nettop is busy; watch the keyboard meanwhile
            keys = ""
            if tty_in:
                if select.select([sys.stdin], [], [], 0.1)[0]:
                    keys = os.read(sys.stdin.fileno(), 64).decode(errors="ignore")
            else:
                time.sleep(0.1)
            poll(keys)
        reader.join()
    finally:
        if proc.poll() is None:
            proc.kill()
            proc.wait()
    if proc.returncode:
        err = proc.stderr.read().strip().removeprefix("nettop: ")
        sys.exit(f"nettop failed: {err or f'exit status {proc.returncode}'}")

    rows, block = [], 0
    for line in (captured[0] if captured else "").splitlines():
        if line.startswith(",bytes_in"):
            block += 1
            continue
        if block != 2:  # first block is cumulative-since-boot, ignore it
            continue
        parts = line.split(",")
        if len(parts) < 3 or not parts[0]:
            continue
        try:
            down, up = int(parts[1]) / interval, int(parts[2]) / interval
        except ValueError:
            continue
        if down == 0 and up == 0:
            continue
        name, _, pid = parts[0].rpartition(".")
        rows.append((name or parts[0], pid, down, up))

    names = real_names([r[1] for r in rows])
    return [(names.get(pid) or name, pid, d, u) for name, pid, d, u in rows]


def scale(rows, prev: float) -> float:
    """Bar scale that rises instantly but decays slowly, so bars stop twitching.
    Bars are stacked down+up, so the scale is the largest combined rate. It covers
    every active process, not just the visible ones, so re-sorting never breaks it."""
    cur = max((r[2] + r[3] for r in rows), default=0.0)
    return max(cur, prev * PEAK_DECAY, 1.0)


# ── drawing ──────────────────────────────────────────────────────────────────

def layout(width: int) -> dict:
    """Column widths for a window `width` cells wide. The bar absorbs spare room
    (up to BAR_MAX); PID goes first when space runs out, then the bar."""
    room = max(width - GUTTER - 1, 1)
    for pid in (W_PID, 0):
        fixed = (2 + pid if pid else 0) + 3 + W_RATE + 2 + W_RATE + 3
        rest = min(room, MAX_WIDTH) - fixed
        name = max(NAME_MIN, min(NAME_MAX, rest // 2))
        bar = min(BAR_MAX, rest - name)
        if bar >= BAR_MIN:
            return {"name": name, "pid": pid, "bar": bar, "total": fixed + name + bar}
    name = max(1, min(NAME_MAX, rest))
    return {"name": name, "pid": 0, "bar": 0, "total": fixed - 3 + name}


def fit(text: str | Text, width: int, style: str = "", right: bool = False) -> Text:
    """Exactly `width` cells: truncated with an ellipsis, padded with spaces."""
    t = text.copy() if isinstance(text, Text) else Text(text, style=style)
    t.truncate(width, overflow="ellipsis")
    t.align("right" if right else "left", width)
    return t


def rate(bps: float, colour: str) -> Text:
    """A rate in its column colour, or a quiet dash for nothing."""
    return Text(human(bps), style=colour) if bps > 0 else Text("–", style="dim")


def bar(down: float, up: float, peak: float, width: int) -> Text:
    """Stacked down+up line in half-cell steps."""
    halves = width * 2
    d_end = min(round(down / peak * halves), halves)
    t_end = min(round((down + up) / peak * halves), halves)
    out = Text()
    for c in range(width):
        left, right = 2 * c, 2 * c + 1
        colour = DOWN if left < d_end else UP if left < t_end else None
        if colour is None:
            out.append(" ")
        elif right < t_end:
            out.append("━", style=colour)
        else:
            out.append("╸", style=colour)
    return out


def hints(sep: str = "   ") -> Text:
    return Text(sep).join(Text.assemble((k, "bold"), " " + label) for k, label in KEYS)


def footer(width: int, iface: str, interval: int, interactive: bool) -> Text:
    """Key hints on the left, what is being measured on the right. Tightens the
    hints, then shortens the right side, before giving anything up."""
    if not interactive:  # stdin isn't a keyboard, so only Ctrl-C reaches us
        keys = [Text.assemble(("Ctrl-C", "bold"), " to quit")]
    else:
        keys = [hints("   "), hints("  ")]
    metas = [Text(f"{IFACE_LABEL[iface]}, every {interval}s", style="dim"),
             Text(f"{IFACE_SHORT[iface]}, {interval}s", style="dim")]
    for meta in metas:
        for k in keys:
            if k.cell_len + 3 + meta.cell_len <= width:
                return spread(k, meta, width)
    for k in keys:
        if k.cell_len <= width:
            return k
    return fit(Text(" ").join(Text(k, style="bold") for k, _ in KEYS) if interactive
               else keys[0], width)


def spread(left: Text, right: Text, width: int) -> Text:
    """left … right on one line of `width` cells; right is dropped if it won't fit."""
    gap = width - left.cell_len - right.cell_len
    if gap < 3:
        return fit(left, width)
    return Text.assemble(left, " " * gap, right)


def render(rows, *, width: int, height: int, top: int, key: str, desc: bool,
           peak: float, interval: int, iface: str, updated: float | None,
           interactive: bool = True) -> Group:
    """One full frame. rows=None means the first sample hasn't arrived yet."""
    L = layout(width)
    arrow = " ▾" if desc else " ▴"
    measuring = rows is None
    rows = rows or []

    # Rows: as many as fit, so the key hints never fall off a short window.
    room = height - CHROME
    compact = room < 1
    n = max(0, min(top, height - 3 if compact else room))

    # Totals, with how many processes and when, on the right. The clock is the
    # last thing to go: without it you can't tell a frozen screen from a quiet one.
    if measuring:
        totals = Text.assemble(("↓ ", DOWN), ("–", "dim"), "    ", ("↑ ", UP), ("–", "dim"))
        meta = Text("")
    else:
        down = (f"↓ {human(sum(r[2] for r in rows))}", f"bold {DOWN}")
        up = (f"↑ {human(sum(r[3] for r in rows))}", f"bold {UP}")
        clock = time.strftime("%H:%M:%S", time.localtime(updated))
        count = (f"{n} of {len(rows)} active" if 0 < n < len(rows) else f"{len(rows)} active")
        for gap, m in (("    ", f"{count}, updated {clock}"), ("    ", f"updated {clock}"),
                       ("    ", clock), ("  ", clock)):
            totals, meta = Text.assemble(down, gap, up), Text(m)
            if totals.cell_len + 3 + meta.cell_len <= L["total"]:
                break

    def title(label: str, col: str, w: int, right: bool = True) -> Text:
        if key == col:
            return fit(Text(label + arrow, style="bold"), w, right=right)
        return fit(label, w, right=right)

    # With no bar column to carry it, the total sort is named beside Process.
    by_total = key == "total" and not L["bar"]
    head = title("Process", "", L["name"], right=False)
    if by_total:
        for label in (Text.assemble("Process", (" by total" + arrow, "bold")),
                      Text("By total" + arrow, style="bold"), Text("Total" + arrow, style="bold")):
            if label.cell_len <= L["name"]:
                head = fit(label, L["name"])
                break
    if L["pid"]:
        head.append_text(Text.assemble("  ", fit("PID", L["pid"], right=True)))
    head.append_text(Text.assemble("   ", title("Down", "down", W_RATE),
                                   "  ", title("Up", "up", W_RATE)))
    if L["bar"]:
        head.append_text(Text.assemble("   ", title("Total", "total", L["bar"], right=False)))

    body = []
    for name, pid, down, up in rows[:n]:
        line = fit(name, L["name"])
        if L["pid"]:
            line.append_text(Text.assemble("  ", fit(pid, L["pid"], "dim", right=True)))
        d, u = rate(down, DOWN), rate(up, UP)
        if key == "down" and down > 0:  # the sorted column carries a little weight
            d.stylize("bold")
        elif key == "up" and up > 0:
            u.stylize("bold")
        line.append_text(Text.assemble("   ", fit(d, W_RATE, right=True),
                                       "  ", fit(u, W_RATE, right=True)))
        if L["bar"]:
            line.append_text(Text.assemble("   ", bar(down, up, peak, L["bar"])))
        body.append(line)
    if not body and n:
        note = ("Measuring network activity…" if measuring
                else f"No network activity in the last {interval}s")
        body.append(fit(note, L["total"]))
    body += [Text("")] * (n - len(body))  # pad so the key hints never move

    foot = footer(L["total"], iface, interval, interactive)
    top_line = spread(totals, meta, L["total"])
    lines = ([top_line, head, *body, foot] if compact else
             [Text(""), top_line, Text(""), head, *body, Text(""), foot])
    pad = " " * GUTTER
    out = []
    for t in lines[:height]:
        t = Text.assemble(pad, t)
        t.no_wrap, t.overflow = True, "crop"
        out.append(t)
    return Group(*out)


@contextlib.contextmanager
def cbreak():
    """Read single keypresses without Enter, restoring the terminal on exit."""
    if not sys.stdin.isatty():
        yield
        return
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        yield
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


class Quit(Exception):
    """Raised out of the keypress handler when the user presses q."""


def seconds(value: str) -> int:
    """nettop only samples in whole seconds; anything else would skew every rate."""
    try:
        s = float(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {value!r}") from None
    if not math.isfinite(s) or s < 1 or s != int(s):
        raise argparse.ArgumentTypeError("use a whole number of seconds, 1 or more")
    return int(s)


def main() -> None:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-s", "--interval", type=seconds, default=2,
                    help="sample seconds, whole numbers (default 2)")
    ap.add_argument("-n", "--top", type=int, default=15,
                    help="most rows to show (default 15; fewer if the window is short)")
    ap.add_argument("-i", "--iface", choices=list(IFACE_CHOICES), default="external",
                    help="interface filter (default external: skips loopback)")
    ap.add_argument("-k", "--sort", choices=["down", "up", "total"], default="total",
                    help="initial sort column (default total)")
    ap.add_argument("-r", "--reverse", action="store_true",
                    help="ascending (quietest first) instead of descending")
    args = ap.parse_args()
    if args.top < 1:
        ap.error("--top must be 1 or more")

    console = Console()
    state = {"key": args.sort, "desc": not args.reverse, "rows": None, "peak": 1.0,
             "updated": None, "size": None}

    def draw(live):
        size = console.size
        rows = state["rows"]
        ordered = None if rows is None else sort_rows(rows, state["key"], state["desc"])
        live.update(render(ordered, width=size.width, height=size.height, top=args.top,
                           key=state["key"], desc=state["desc"], peak=state["peak"],
                           interval=args.interval, iface=args.iface,
                           updated=state["updated"], interactive=sys.stdin.isatty()),
                    refresh=True)
        state["size"] = size

    try:
        with cbreak(), Live(console=console, screen=True, auto_refresh=False) as live:
            def poll(keys):
                changed = console.size != state["size"]  # window resized
                for ch in keys.lower():
                    if ch == "q":
                        raise Quit
                    if ch in SORT_KEYS:
                        state["key"] = SORT_KEYS[ch]
                        changed = True
                    elif ch == "r":
                        state["desc"] = not state["desc"]
                        changed = True
                if changed:
                    draw(live)  # instant feedback, don't wait for the next sample

            while True:
                draw(live)
                rows = sample(args.interval, IFACE_CHOICES[args.iface], poll)
                state["rows"], state["updated"] = rows, time.time()
                state["peak"] = scale(rows, state["peak"])
    except (Quit, KeyboardInterrupt):
        pass


if __name__ == "__main__":
    main()
